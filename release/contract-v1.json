{
  "major": 1,
  "action": {
    "inputs": {
      "vault": { "required": false, "default": "" },
      "workspace": { "required": false, "default": "" },
      "output": { "required": false, "default": "dist" },
      "site": { "required": false, "default": "" },
      "base-path": { "required": false, "default": "/" },
      "exclusions": { "required": false, "default": "" },
      "strict-links": { "required": false, "default": "false" }
    },
    "outputs": ["output-path"]
  },
  "pagesWorkflow": {
    "inputs": {
      "vault": { "required": false, "default": "", "type": "string" },
      "workspace": { "required": false, "default": "", "type": "string" },
      "exclusions": { "required": false, "default": "", "type": "string" },
      "strict-links": { "required": false, "default": false, "type": "boolean" }
    },
    "outputs": ["page-url"]
  }
}
