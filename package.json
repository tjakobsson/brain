{
  "name": "brain",
  "description": "Generate a static second-brain site from Brain Markdown",
  "type": "module",
  "version": "1.5.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tjakobsson/brain.git"
  },
  "homepage": "https://github.com/tjakobsson/brain#readme",
  "bugs": {
    "url": "https://github.com/tjakobsson/brain/issues"
  },
  "bin": {
    "brain": "scripts/generator.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/generator.mjs build",
    "preview": "node scripts/generator.mjs preview",
    "test:container-live": "node scripts/container-live-smoke.mjs",
    "test:container-workspace": "node scripts/container-workspace-smoke.mjs",
    "vault:generate": "node scripts/generate-stress-vault.mjs",
    "astro": "astro",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:stress-graph": "playwright test --config playwright.stress.config.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.4",
    "@r4ai/remark-callout": "0.6.2",
    "astro": "7.2.9",
    "chokidar": "5.0.0",
    "fuse.js": "7.5.0",
    "graphology": "0.26.0",
    "graphology-layout-forceatlas2": "0.10.1",
    "gray-matter": "4.0.3",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "micromark-extension-gfm": "3.0.0",
    "rehype-raw": "7.0.0",
    "seedrandom": "3.0.5",
    "sigma": "3.0.3",
    "zod": "4.4.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/mdast": "4.0.4",
    "@types/seedrandom": "3.0.8",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
