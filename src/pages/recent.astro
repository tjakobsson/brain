---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLinkIndex } from "../lib/link-index";
import type { VaultNote } from "../lib/vault-scan";
import { joinBase } from "../lib/routes";

const index = getLinkIndex();

function lastChanged(note: VaultNote): Date | null {
  const frontmatterDate = note.meta.updated ?? note.meta.created;
  if (frontmatterDate) {
    const parsed = new Date(frontmatterDate);
    if (!Number.isNaN(parsed.getTime())) return parsed;
  }
  return null;
}

const dateFormatter = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const notes = [...index.notes]
  .map((note) => ({ note, changed: lastChanged(note) }))
  .sort((a, b) => {
    const dateOrder = (b.changed?.getTime() ?? 0) - (a.changed?.getTime() ?? 0);
    return dateOrder || a.note.vaultPath.localeCompare(b.note.vaultPath);
  });
---

<BaseLayout title="Recently changed">
  <h1>Recently changed</h1>
  <ul class="note-list recent-list">
    {notes.map(({ note, changed }) => (
      <li>
        <div class="note-line">
          <a href={joinBase(import.meta.env.BASE_URL, note.route)}>{note.title}</a>
          {changed && <time class="date" datetime={changed.toISOString()}>{dateFormatter.format(changed)}</time>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
