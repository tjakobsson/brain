---
import BaseLayout from "../layouts/BaseLayout.astro";
import { joinBase, routes } from "../lib/routes";

// `/graph` is kept only so previously shared combined-view links land on the
// full workspace graph (or the vault graph) at the site root.
const redirect = joinBase(import.meta.env.BASE_URL, routes.home);
---

<BaseLayout title="Graph">
  <Fragment slot="head">
    <meta http-equiv="refresh" content={`0;url=${redirect}`} />
  </Fragment>
  <div class="recovery-page" data-graph-redirect={redirect}>
    <div class="recovery-card">
      <p class="eyebrow">Graph moved</p>
      <h1>Continue to the graph</h1>
      <a href={redirect}>Open graph</a>
    </div>
  </div>
</BaseLayout>

<script>
  const redirect = document.querySelector<HTMLElement>("[data-graph-redirect]");
  if (redirect?.dataset.graphRedirect) {
    window.location.replace(redirect.dataset.graphRedirect);
  }
</script>
