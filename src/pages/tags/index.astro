---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getLinkIndex } from "../../lib/link-index";
import { joinBase, routes } from "../../lib/routes";
const index = getLinkIndex();
const counts = new Map<string, number>();
for (const note of index.notes) {
  for (const tag of note.meta.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags">
  <h1>Tags</h1>
  <ul class="note-list">
    {tags.map(([tag, count]) => (
      <li>
        <div class="note-line">
          <a href={joinBase(import.meta.env.BASE_URL, routes.tag(tag))}>#{tag}</a>
          <span class="date">{count} {count === 1 ? "note" : "notes"}</span>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
