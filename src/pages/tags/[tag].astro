---
import TaggedNotes from "../../components/TaggedNotes.astro";
import { getLinkIndex, type LinkIndex } from "../../lib/link-index";
import { getWorkspaceSnapshot } from "../../lib/vault-state";

export function getStaticPaths() {
  if (getWorkspaceSnapshot().mode === "workspace") return [];
  const index: LinkIndex = getLinkIndex();
  const tags = new Set<string>();
  for (const note of index.notes) {
    for (const tag of note.meta.tags) tags.add(tag);
  }
  return [...tags].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
---

<TaggedNotes tag={tag!} />
