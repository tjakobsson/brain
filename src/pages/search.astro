---
import BaseLayout from "../layouts/BaseLayout.astro";
import { joinBase, routes } from "../lib/routes";
const pagefindCss = joinBase(import.meta.env.BASE_URL, routes.pagefindUiCss);
---

<BaseLayout title="Search">
  <div class="search-page">
    <h1>Search</h1>
    <div id="search-box"></div>
    <p id="search-unavailable" hidden>
      The full-text index only exists after a production build — run
      <code>npm run build</code> then <code>npm run preview</code>. The ⌘K quick
      switcher works everywhere, including dev.
    </p>
  </div>

  <link href={pagefindCss} rel="stylesheet" />
  <script>
    import { joinBase, routes } from "../lib/routes";

    window.addEventListener("DOMContentLoaded", async () => {
      const pagefindJs = joinBase(import.meta.env.BASE_URL, routes.pagefindUiJs);
      const probe = await fetch(pagefindJs, { method: "HEAD" });
      if (!probe.ok) {
        document.getElementById("search-unavailable")!.hidden = false;
        return;
      }
      await import(/* @vite-ignore */ pagefindJs);
      new window.PagefindUI({
        element: "#search-box",
        showSubResults: true,
        baseUrl: joinBase(import.meta.env.BASE_URL, routes.home),
        bundlePath: joinBase(import.meta.env.BASE_URL, routes.pagefind),
      });
    });
  </script>
</BaseLayout>
