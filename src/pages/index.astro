---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrainChooser from "../components/BrainChooser.astro";
import GlobalGraph from "../components/GlobalGraph.astro";
import { getWorkspaceSnapshot } from "../lib/vault-state";

const snapshot = getWorkspaceSnapshot();
---

{snapshot.mode === "workspace" ? (
  <BaseLayout title={snapshot.registry.title}>
    <BrainChooser registry={snapshot.registry} />
  </BaseLayout>
) : (
  <BaseLayout title="Graph" fluid>
    <GlobalGraph />
  </BaseLayout>
)}
