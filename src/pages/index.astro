---
import BaseLayout from "../layouts/BaseLayout.astro";
import GlobalGraph from "../components/GlobalGraph.astro";
import { getWorkspaceSnapshot } from "../lib/vault-state";
import packageMetadata from "../../package.json";

// The site root is the graph: the vault graph in vault mode, and in workspace
// mode the full workspace graph with every configured Brain present. The root
// is the only page that exposes About.
const snapshot = getWorkspaceSnapshot();
const isWorkspace = snapshot.mode === "workspace";
const generatorLabel = `Brain v${packageMetadata.version}`;
---

<BaseLayout title={isWorkspace ? snapshot.registry.title : "Graph"} fluid>
  <GlobalGraph />
  {isWorkspace && (
    <footer class="graph-about">
      <button
        class="graph-about__trigger"
        type="button"
        aria-label="About"
        aria-controls="graph-about-disclosure"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="8"></circle>
          <path d="M12 11v5M12 8h.01"></path>
        </svg>
        <span>About</span>
      </button>
      <aside id="graph-about-disclosure" class="about-disclosure" hidden aria-label="About Brain">
        <p class="eyebrow">Brain workspace</p>
        <p class="about-title">{snapshot.registry.title}</p>
        {snapshot.registry.description && <p class="about-description">{snapshot.registry.description}</p>}
        <p class="eyebrow">Generated with</p>
        <p class="about-version">{generatorLabel}</p>
        <a href="https://github.com/tjakobsson/brain">Project releases</a>
      </aside>
    </footer>
  )}
</BaseLayout>

<script>
  const trigger = document.querySelector<HTMLButtonElement>(".graph-about__trigger");
  const disclosure = document.querySelector<HTMLElement>("#graph-about-disclosure");
  if (trigger && disclosure) {
    const close = (restoreFocus = false) => {
      disclosure.hidden = true;
      trigger.setAttribute("aria-expanded", "false");
      if (restoreFocus) trigger.focus();
    };
    trigger.addEventListener("click", () => {
      const open = disclosure.hidden;
      close();
      if (open) {
        disclosure.hidden = false;
        trigger.setAttribute("aria-expanded", "true");
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (
        !disclosure.hidden &&
        event.target instanceof Node &&
        !disclosure.contains(event.target) &&
        !trigger.contains(event.target)
      ) close();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && !disclosure.hidden) close(true);
    });
  }
</script>
