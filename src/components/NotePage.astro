---
import { render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteMeta from "./NoteMeta.astro";
import NoteMentions from "./NoteMentions.astro";
import GraphLegend from "./GraphLegend.astro";
import { getLinkIndex } from "../lib/link-index";
import { joinBase, routesFor } from "../lib/routes";
import { getWorkspaceSnapshot } from "../lib/vault-state";

const { entry } = Astro.props;
const { Content } = await render(entry);
const snapshot = getWorkspaceSnapshot();
const index = getLinkIndex();
const note = index.byId.get(entry.id);
if (!note) throw new Error(`Note ${JSON.stringify(entry.id)} is missing from the workspace index.`);
const title = entry.data.title ?? note.title;
const brain = snapshot.registry.brains.find(({ id }) => id === note.brainId);
if (!brain) throw new Error(`Note ${JSON.stringify(entry.id)} has unknown brain ${JSON.stringify(note.brainId)}.`);
const adjacency = new Map<string, Set<string>>();
for (const { source, target } of index.edges) {
  adjacency.set(source, (adjacency.get(source) ?? new Set()).add(target));
  adjacency.set(target, (adjacency.get(target) ?? new Set()).add(source));
}
const localIds = new Set([entry.id]);
let frontier = [entry.id];
for (let depth = 0; depth < 2; depth += 1) {
  const next: string[] = [];
  for (const id of frontier) {
    for (const nearby of adjacency.get(id) ?? []) {
      if (localIds.has(nearby) || index.byId.get(nearby)?.brainId !== note.brainId) continue;
      localIds.add(nearby);
      next.push(nearby);
    }
  }
  frontier = next;
}
const nearbyIds = new Set<string>();
for (const id of localIds) {
  if (id !== entry.id) nearbyIds.add(id);
  for (const nearby of adjacency.get(id) ?? []) {
    if (index.byId.get(nearby)?.brainId !== note.brainId) nearbyIds.add(nearby);
  }
}
const nearbyNotes = index.notes
  .filter(({ id }) => nearbyIds.has(id))
  .sort((a, b) => a.title.localeCompare(b.title));
const localLegendBrainIds = new Set([note.brainId, ...nearbyNotes.map(({ brainId }) => brainId)]);
const localLegendBrains = snapshot.registry.brains.filter(({ id }) => localLegendBrainIds.has(id));
const contextualRoutes = routesFor(
  snapshot.mode === "workspace"
    ? { mode: "workspace", brainId: note.brainId }
    : { mode: "vault" },
);
const url = (route: import("../lib/routes").LogicalRoute) =>
  joinBase(import.meta.env.BASE_URL, route);
// The note-owned neighborhood page is the only shareable identity of this
// note's focused graph; it is a pathname, never query state.
const neighborhoodRoute = contextualRoutes.neighborhood(note.slug);
---

<BaseLayout
  title={title}
  activeBrainId={snapshot.mode === "workspace" ? note.brainId : undefined}
  noteContext={{ ownerBrainId: note.brainId, compositeId: note.compositeId, neighborhoodRoute }}
>
  <article data-brain-id={note.brainId} data-brain-title={brain.title}>
    <header class="note-heading">
      <h1>{title}</h1>
      <a
        class="note-focus-action"
        href={url(neighborhoodRoute)}
        data-focused-graph-route
        aria-label={`View ${title} in its focused graph neighborhood`}
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M7.5 7.5 12 5l4.5 2.5v5L12 15l-4.5-2.5z"></path>
          <path d="M7.5 12.5 5 17m11.5-4.5L19 17M12 15v4"></path>
          <circle cx="5" cy="17" r="1.5"></circle>
          <circle cx="19" cy="17" r="1.5"></circle>
          <circle cx="12" cy="20" r="1.5"></circle>
        </svg>
        <span>Focused graph</span>
      </a>
    </header>
    <NoteMeta
      brainId={note.brainId}
      type={entry.data.type}
      status={entry.data.status}
      tags={entry.data.tags}
      created={entry.data.created}
      updated={entry.data.updated}
    />
    <Content />
  </article>
  <NoteMentions noteId={entry.id} brainId={note.brainId} />
  {nearbyNotes.length > 0 && (
    <section class="local-graph-panel" aria-labelledby="local-graph-heading">
      <header class="local-graph-panel__header">
        <div>
          <h2 id="local-graph-heading">Connection map</h2>
          <p>Notes up to two links away from this note.</p>
        </div>
        <div class="local-graph-panel__actions">
          <button class="graph-control" type="button" data-fit-local-graph>Fit view</button>
          <GraphLegend
            id="local-graph-legend"
            context="local"
            brains={localLegendBrains}
            activeBrainId={note.brainId}
          />
          <a href={url(neighborhoodRoute)} data-focused-graph-route>Open full graph</a>
        </div>
      </header>
      <div class="local-graph" data-slug={entry.id} data-active-brain-id={note.brainId} aria-hidden="true"></div>
      <nav class="local-graph-links" aria-label="Notes in the connection map">
        <span>Nearby notes</span>
        <ul>
          {nearbyNotes.map((nearby) => (
            <li>
              <a href={url(nearby.route)} data-note-route={nearby.route}>
                {nearby.title}
                {nearby.brainId !== note.brainId && <span class="brain-badge">↗ @{nearby.brainId}</span>}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  )}
</BaseLayout>

<script>
  import { mountLocalGraphs } from "../lib/graph-view";

  for (const block of document.querySelectorAll<HTMLElement>("article pre")) {
    const code = block.querySelector("code");
    if (!code) continue;

    const wrapper = document.createElement("div");
    wrapper.className = "code-block";
    block.before(wrapper);
    wrapper.append(block);

    const button = document.createElement("button");
    button.className = "code-block-copy";
    button.type = "button";
    button.setAttribute("aria-label", "Copy code");
    button.innerHTML = `<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="8" y="8" width="11" height="11" rx="2"></rect><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"></path></svg><span class="code-copy-feedback" aria-hidden="true"></span>`;
    wrapper.append(button);

    let resetTimer: number | undefined;
    button.addEventListener("click", async () => {
      window.clearTimeout(resetTimer);
      const feedback = button.querySelector<HTMLElement>(".code-copy-feedback");
      try {
        await navigator.clipboard.writeText(code.textContent ?? "");
        button.dataset.copyState = "copied";
        button.setAttribute("aria-label", "Copied");
        if (feedback) feedback.textContent = "Copied";
      } catch {
        button.dataset.copyState = "failed";
        button.setAttribute("aria-label", "Copy failed");
        if (feedback) feedback.textContent = "Copy failed";
      }
      resetTimer = window.setTimeout(() => {
        delete button.dataset.copyState;
        button.setAttribute("aria-label", "Copy code");
        if (feedback) feedback.textContent = "";
      }, 2000);
    });
  }

  if (window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
    for (const panel of document.querySelectorAll<HTMLElement>(".local-graph-panel")) {
      panel.addEventListener("pointerenter", () => panel.setAttribute("data-spotlight", ""));
      panel.addEventListener("pointermove", (event) => {
        const bounds = panel.getBoundingClientRect();
        panel.style.setProperty("--graph-spotlight-x", `${event.clientX - bounds.left}px`);
        panel.style.setProperty("--graph-spotlight-y", `${event.clientY - bounds.top}px`);
      });
      panel.addEventListener("pointerleave", () => panel.removeAttribute("data-spotlight"));
    }
  }
  mountLocalGraphs().catch((err) => console.error("[local-graph] failed to mount", err));
</script>
