---
import { getLinkIndex } from "../lib/link-index";
import { joinBase } from "../lib/routes";

interface Props {
  slug: string;
}

const { slug } = Astro.props;
const index = getLinkIndex();
const linked = index.backlinks.get(slug) ?? [];
const unlinked = index.unlinkedMentions.get(slug) ?? [];
---

{linked.length > 0 && (
  <section class="mentions">
    <h2>Linked mentions</h2>
    <ul>
      {linked.map(({ source, context }) => (
        <li>
          <a href={joinBase(import.meta.env.BASE_URL, source.route)}>{source.title}</a>
          {context && <span class="context">{context}</span>}
        </li>
      ))}
    </ul>
  </section>
)}

{unlinked.length > 0 && (
  <section class="mentions">
    <h2>Unlinked mentions</h2>
    <ul>
      {unlinked.map((source) => (
        <li>
          <a href={joinBase(import.meta.env.BASE_URL, source.route)}>{source.title}</a>
        </li>
      ))}
    </ul>
  </section>
)}
