---
import BaseLayout from "../layouts/BaseLayout.astro";
import { joinBase, routes } from "../lib/routes";

interface Props { label: string }
const { label } = Astro.props;
const chooser = joinBase(import.meta.env.BASE_URL, routes.home);
---

<BaseLayout title="Choose a brain">
  <meta http-equiv="refresh" content={`0; url=${chooser}`} slot="head" />
  <h1>Choose a brain</h1>
  <p>{label} belongs to a specific brain in workspace mode.</p>
  <p><a href={chooser}>Return to the brain chooser</a></p>
</BaseLayout>
