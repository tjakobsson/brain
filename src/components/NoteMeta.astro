---
import { joinBase, routesFor } from "../lib/routes";
import { formatTimestamp } from "../lib/timestamps";
import { getWorkspaceSnapshot } from "../lib/vault-state";
import BrainMark from "./BrainMark.astro";

interface Props {
  brainId: string;
  type: "fleeting" | "literature" | "permanent";
  status: "draft" | "developing" | "established";
  tags: string[];
  created?: Date;
  updated?: Date;
}

const { brainId, type, status, tags, created, updated } = Astro.props;
const snapshot = getWorkspaceSnapshot();
const brain = snapshot.mode === "workspace"
  ? snapshot.registry.brains.find(({ id }) => id === brainId)
  : undefined;
if (snapshot.mode === "workspace" && !brain) {
  throw new Error(`Unknown note brain ${JSON.stringify(brainId)}.`);
}
const contextualRoutes = routesFor(
  snapshot.mode === "workspace" ? { mode: "workspace", brainId } : { mode: "vault" },
);

const STATUS_GLYPHS = { draft: "○", developing: "◐", established: "●" } as const;
---

<div class="note-meta">
  {brain && (
    <span
      class="note-brain"
      style={`--brain-accent: ${brain.accent}`}
      aria-label={`Brain: ${brain.title} (@${brain.id})`}
      title={brain.title}
    >
      <BrainMark />
      <span class="note-brain__id">@{brain.id}</span>
    </span>
  )}
  <span class={`chip type-${type}`}><span class="dot"></span>{type}</span>
  <span class={`status status-${status}`}>
    <span class="glyph">{STATUS_GLYPHS[status]}</span>
    {status}
  </span>
  {tags.map((tag) => <a class="tag-link" href={joinBase(import.meta.env.BASE_URL, contextualRoutes.tag(tag))}>#{tag}</a>)}
  {created && <span>created <time datetime={created.toISOString()}>{formatTimestamp(created)}</time></span>}
  {updated && <span>updated <time datetime={updated.toISOString()}>{formatTimestamp(updated)}</time></span>}
</div>
