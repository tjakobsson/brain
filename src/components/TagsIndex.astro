---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getLinkIndex } from "../lib/link-index";
import { joinBase, routesFor } from "../lib/routes";
import { getWorkspaceSnapshot } from "../lib/vault-state";

interface Props { brainId?: string }
const { brainId } = Astro.props;
const snapshot = getWorkspaceSnapshot();
const notes = getLinkIndex().notes.filter(
  (note) => brainId === undefined || note.brainId === brainId,
);
const contextualRoutes = routesFor(
  snapshot.mode === "workspace" && brainId
    ? { mode: "workspace", brainId }
    : { mode: "vault" },
);
const counts = new Map<string, number>();
for (const note of notes) {
  for (const tag of note.meta.tags) counts.set(tag, (counts.get(tag) ?? 0) + 1);
}
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" activeBrainId={brainId}>
  <h1>Tags</h1>
  <ul class="note-list">
    {tags.map(([tag, count]) => (
      <li>
        <div class="note-line">
          <a href={joinBase(import.meta.env.BASE_URL, contextualRoutes.tag(tag))}>#{tag}</a>
          <span class="date">{count} {count === 1 ? "note" : "notes"}</span>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
