---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrainOwner from "./BrainOwner.astro";
import { getLinkIndex } from "../lib/link-index";
import { joinBase, routesFor } from "../lib/routes";
import { getWorkspaceSnapshot } from "../lib/vault-state";

interface Props { brainId?: string }
const { brainId } = Astro.props;
const snapshot = getWorkspaceSnapshot();
// Without a Brain this is the vault index or, in workspace mode, the
// workspace-wide aggregate: the union of every Brain's tags.
const aggregate = snapshot.mode === "workspace" && brainId === undefined;
const notes = getLinkIndex().notes.filter(
  (note) => brainId === undefined || note.brainId === brainId,
);
const contextualRoutes = routesFor(
  snapshot.mode === "workspace" && brainId
    ? { mode: "workspace", brainId }
    : { mode: "vault" },
);
const counts = new Map<string, number>();
const owners = new Map<string, Set<string>>();
for (const note of notes) {
  for (const tag of note.meta.tags) {
    counts.set(tag, (counts.get(tag) ?? 0) + 1);
    owners.set(tag, (owners.get(tag) ?? new Set()).add(note.brainId));
  }
}
const brainOrder = snapshot.registry.brains.map(({ id }) => id);
const tags = [...counts.entries()].sort((a, b) => a[0].localeCompare(b[0]));
---

<BaseLayout title="Tags" activeBrainId={brainId}>
  <h1>Tags</h1>
  <ul class="note-list">
    {tags.map(([tag, count]) => (
      <li>
        <div class="note-line">
          <a href={joinBase(import.meta.env.BASE_URL, contextualRoutes.tag(tag))}>#{tag}</a>
          {aggregate && (
            <span class="note-owners">
              {brainOrder.filter((id) => owners.get(tag)?.has(id)).map((id) => <BrainOwner brainId={id} />)}
            </span>
          )}
          <span class="date">{count} {count === 1 ? "note" : "notes"}</span>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
