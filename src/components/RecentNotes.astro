---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrainOwner from "./BrainOwner.astro";
import { getLinkIndex } from "../lib/link-index";
import type { VaultNote } from "../lib/vault-scan";
import { joinBase } from "../lib/routes";
import { formatTimestamp } from "../lib/timestamps";
import { getWorkspaceSnapshot } from "../lib/vault-state";

interface Props { brainId?: string }
const { brainId } = Astro.props;
const index = getLinkIndex();
// Without a Brain in workspace mode this aggregates every Brain's notes, so
// each entry names its owner.
const aggregate = getWorkspaceSnapshot().mode === "workspace" && brainId === undefined;

function lastChanged(note: VaultNote): Date | null {
  const frontmatterDate = note.meta.updated ?? note.meta.created;
  if (!frontmatterDate) return null;
  const parsed = new Date(frontmatterDate);
  return Number.isNaN(parsed.getTime()) ? null : parsed;
}

const notes = index.notes
  .filter((note) => brainId === undefined || note.brainId === brainId)
  .map((note) => ({ note, changed: lastChanged(note) }))
  .sort((a, b) => {
    const dateOrder = (b.changed?.getTime() ?? 0) - (a.changed?.getTime() ?? 0);
    return dateOrder || a.note.vaultPath.localeCompare(b.note.vaultPath);
  });
---

<BaseLayout title="Recently changed" activeBrainId={brainId}>
  <h1>Recently changed</h1>
  <ul class="note-list recent-list">
    {notes.map(({ note, changed }) => (
      <li>
        <div class="note-line">
          <a href={joinBase(import.meta.env.BASE_URL, note.route)}>{note.title}</a>
          {aggregate && <BrainOwner brainId={note.brainId} />}
          {changed && <time class="date" datetime={changed.toISOString()}>{formatTimestamp(changed)}</time>}
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
