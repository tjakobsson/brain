---
import type { WorkspaceDefinition, WorkspaceGroup } from "../lib/workspace.mjs";
import { joinBase, routesFor } from "../lib/routes";
import BrainMark from "./BrainMark.astro";

interface Props { registry: WorkspaceDefinition }
const { registry } = Astro.props;
const byGroup = new Map<string, typeof registry.brains>();
for (const group of registry.groups) byGroup.set(group.id, []);
const ungrouped = [] as typeof registry.brains;
for (const brain of registry.brains) {
  if (brain.group) byGroup.get(brain.group)?.push(brain);
  else ungrouped.push(brain);
}
const groupsById = new Map(registry.groups.map((group) => [group.id, group]));
function groupDepth(group: WorkspaceGroup): number {
  let depth = 0;
  let parent = group.parent ? groupsById.get(group.parent) : undefined;
  while (parent) {
    depth += 1;
    parent = parent.parent ? groupsById.get(parent.parent) : undefined;
  }
  return depth;
}
const url = (route: import("../lib/routes").LogicalRoute) => joinBase(import.meta.env.BASE_URL, route);
---

<section class="brain-chooser" aria-labelledby="brain-chooser-heading">
  <header class="brain-chooser__intro">
    <p class="eyebrow">Brain workspace</p>
    <h1 id="brain-chooser-heading">{registry.title}</h1>
    {registry.description && <p>{registry.description}</p>}
  </header>

  <form class="brain-selection" data-brain-selection data-registry={registry.brains.map(({ id }) => id).join(",")}>
    <div class="brain-hierarchy">
      {registry.groups.map((group) => (
        <section class="brain-group" style={`--group-depth: ${groupDepth(group)}`}>
          <h2>{group.title}</h2>
          {(byGroup.get(group.id) ?? []).length > 0 && (
            <div class="brain-grid">
              {(byGroup.get(group.id) ?? []).map((brain) => (
                <article class="brain-card" style={`--brain-accent: ${brain.accent}`}>
                  <label class="brain-card__select">
                    <input type="checkbox" name="brain" value={brain.id} />
                    <span>Combine <span class="visually-hidden">{brain.title}</span></span>
                  </label>
                  <div class="brain-card__identity">
                    <BrainMark />
                    <span>@{brain.id}</span>
                  </div>
                  <h3>{brain.title}</h3>
                  {brain.description && <p>{brain.description}</p>}
                  <a href={url(routesFor({ mode: "workspace", brainId: brain.id }).graph)} aria-label={`Enter ${brain.title}`}>
                    Enter Brain <span aria-hidden="true">→</span>
                  </a>
                </article>
              ))}
            </div>
          )}
        </section>
      ))}
      {ungrouped.length > 0 && (
        <section class="brain-group" style="--group-depth: 0">
          <h2>Other brains</h2>
          <div class="brain-grid">
            {ungrouped.map((brain) => (
              <article class="brain-card" style={`--brain-accent: ${brain.accent}`}>
                <label class="brain-card__select">
                  <input type="checkbox" name="brain" value={brain.id} />
                  <span>Combine <span class="visually-hidden">{brain.title}</span></span>
                </label>
                <div class="brain-card__identity">
                  <BrainMark />
                  <span>@{brain.id}</span>
                </div>
                <h3>{brain.title}</h3>
                {brain.description && <p>{brain.description}</p>}
                <a href={url(routesFor({ mode: "workspace", brainId: brain.id }).graph)} aria-label={`Enter ${brain.title}`}>
                  Enter Brain <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </section>
      )}
    </div>
    <footer class="brain-selection__action" hidden>
      <span data-selection-count aria-live="polite">Select at least two brains to combine.</span>
      <button type="submit" disabled>Open combined graph</button>
    </footer>
  </form>
</section>

<script>
  // TODO(default-to-full-workspace-graph): removed in task group 4 (4.4 retires the
  // chooser). The combined-graph destination no longer exists, so the selection
  // form stays inert and its action footer stays hidden until then.
  const form = document.querySelector<HTMLFormElement>("[data-brain-selection]");
  form?.addEventListener("submit", (event) => event.preventDefault());
</script>
