---
import BaseLayout from "../layouts/BaseLayout.astro";
import BrainOwner from "./BrainOwner.astro";
import { getLinkIndex } from "../lib/link-index";
import { joinBase } from "../lib/routes";
import { getWorkspaceSnapshot } from "../lib/vault-state";

interface Props { tag: string; brainId?: string }
const { tag, brainId } = Astro.props;
// Without a Brain in workspace mode this aggregates the tag across every Brain,
// so each note names its owner.
const aggregate = getWorkspaceSnapshot().mode === "workspace" && brainId === undefined;
const notes = getLinkIndex().notes.filter(
  (note) => note.meta.tags.includes(tag) && (brainId === undefined || note.brainId === brainId),
);
---

<BaseLayout title={`#${tag}`} activeBrainId={brainId}>
  <h1>#{tag}</h1>
  <ul class="note-list">
    {notes.map((note) => (
      <li>
        <div class="note-line">
          <a href={joinBase(import.meta.env.BASE_URL, note.route)}>{note.title}</a>
          {aggregate && <BrainOwner brainId={note.brainId} />}
          <span class={`status status-${note.meta.status}`}>{note.meta.status}</span>
        </div>
      </li>
    ))}
  </ul>
</BaseLayout>
