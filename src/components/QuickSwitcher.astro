---
/* Cmd+K quick switcher — included in BaseLayout so it exists on every page. */
interface Props {
  activeBrainId?: string;
  combined?: boolean;
  workspace?: boolean;
  brainRegistry?: readonly { id: string; title: string }[];
}
const { activeBrainId, combined = false, workspace = false, brainRegistry = [] } = Astro.props;
---

<div id="quick-switcher" class="switcher-overlay" hidden>
  <div class="switcher" role="dialog" aria-modal="true" aria-label="Quick switcher">
    <label class="switcher-scope" hidden={!workspace}>
      <span>Scope</span>
      <select data-switcher-scope aria-label="Quick switcher scope">
        {activeBrainId && <option value="active">Active brain @{activeBrainId}</option>}
        <option value="selected" data-selected-scope hidden={!combined}>Selected brains</option>
        <option value="all">All brains</option>
      </select>
    </label>
    <input
      type="text"
      placeholder="Jump to a note or tag…"
      role="combobox"
      aria-label="Search notes and tags"
      aria-controls="switcher-results"
      aria-expanded="true"
      aria-autocomplete="list"
      data-active-brain-id={activeBrainId}
      data-combined={combined ? "true" : "false"}
      data-workspace={workspace ? "true" : "false"}
      data-brain-registry={JSON.stringify(brainRegistry)}
    />
    <ul id="switcher-results" class="switcher-results" role="listbox"></ul>
    <div class="switcher-empty" role="status" aria-live="polite" hidden>No matches.</div>
  </div>
</div>

<script>
  import Fuse from "fuse.js";
  import { canonicalBrainSelection, joinBase, routes, singularQueryValue, withGraphContext, type LogicalRoute } from "../lib/routes";

  interface Entry {
    title: string;
    route: LogicalRoute;
    kind: "note" | "tag";
    tags: string[];
    brainId: string;
    brainTitle: string;
    brainAccent: string;
  }

  const overlay = document.querySelector<HTMLElement>(".switcher-overlay")!;
  const input = overlay.querySelector<HTMLInputElement>("input")!;
  const resultsList = overlay.querySelector<HTMLElement>(".switcher-results")!;
  const empty = overlay.querySelector<HTMLElement>(".switcher-empty")!;
  const scope = overlay.querySelector<HTMLSelectElement>("[data-switcher-scope]")!;
  const activeBrainId = input.dataset.activeBrainId;
  const combined = input.dataset.combined === "true";
  const workspace = input.dataset.workspace === "true";
  const brainRegistry = JSON.parse(input.dataset.brainRegistry ?? "[]") as { id: string; title: string }[];
  const selectedScope = scope.querySelector<HTMLOptionElement>("[data-selected-scope]")!;

  let entries: Entry[] | null = null;
  let fuse: Fuse<Entry> | null = null;
  let results: Entry[] = [];
  let selected = 0;
  let opener: HTMLElement | null = null;
  let previousOverflow = "";
  let selectedBrainIds: string[] = [];
  const pageRegions = [
    document.querySelector<HTMLElement>(".site-header-slot"),
    document.querySelector<HTMLElement>("main"),
  ].filter((region): region is HTMLElement => region !== null);

  async function ensureIndex(): Promise<void> {
    if (!entries) {
      entries = (await (
        await fetch(joinBase(import.meta.env.BASE_URL, routes.searchIndex))
      ).json()) as Entry[];
      fuse = new Fuse(entries, {
        keys: ["title", "tags"],
        threshold: 0.35,
        ignoreLocation: true,
      });
    }
  }

  function open(): void {
    opener = document.activeElement instanceof HTMLElement && document.activeElement !== document.body
      ? document.activeElement
      : null;
    overlay.hidden = false;
    previousOverflow = document.body.style.overflow;
    document.body.style.overflow = "hidden";
    for (const region of pageRegions) region.inert = true;
    input.value = "";
    const requestedScope = singularQueryValue(new URLSearchParams(window.location.search), "brains");
    const retainedScope = !requestedScope.valid || !requestedScope.present
      ? null
      : canonicalBrainSelection(brainRegistry, requestedScope.value);
    selectedBrainIds = retainedScope?.valid ? [...retainedScope.brainIds] : [];
    selectedScope.hidden = selectedBrainIds.length === 0;
    selectedScope.textContent = selectedBrainIds.length > 0
      ? `Selected brains (${selectedBrainIds.map((id) => `@${id}`).join(", ")})`
      : "Selected brains";
    if (selectedBrainIds.length > 0) scope.value = "selected";
    else if (activeBrainId) scope.value = "active";
    else scope.value = "all";
    input.focus();
    void search();
  }

  function close(): void {
    overlay.hidden = true;
    document.body.style.overflow = previousOverflow;
    for (const region of pageRegions) region.inert = false;
    const fallback = document.querySelector<HTMLElement>(".search-trigger");
    if (opener && opener.offsetParent !== null) opener.focus();
    else fallback?.focus();
    opener = null;
  }

  function renderResults(items: Entry[]): void {
    results = items;
    selected = 0;
    resultsList.innerHTML = "";
    empty.hidden = items.length > 0;
    items.slice(0, 10).forEach((entry, i) => {
      const li = document.createElement("li");
      li.id = `switcher-option-${i}`;
      li.setAttribute("role", "option");
      li.setAttribute("aria-selected", String(i === selected));
      const label = document.createElement("span");
      label.textContent = entry.title;
      const kind = document.createElement("span");
      kind.className = workspace ? "kind kind--brain" : "kind";
      kind.textContent = workspace ? `${entry.kind} · @${entry.brainId}` : entry.kind;
      kind.style.setProperty("--brain-accent", entry.brainAccent);
      li.append(label, kind);
      li.addEventListener("click", () => navigate(entry));
      li.addEventListener("mousemove", () => select(i));
      resultsList.appendChild(li);
    });
    select(0);
  }

  function select(i: number): void {
    selected = i;
    [...resultsList.children].forEach((li, j) =>
      li.setAttribute("aria-selected", String(j === selected)),
    );
    const option = resultsList.children.item(selected);
    if (option) {
      input.setAttribute("aria-activedescendant", option.id);
      option.scrollIntoView({ block: "nearest" });
      const optionRect = option.getBoundingClientRect();
      const listRect = resultsList.getBoundingClientRect();
      if (optionRect.top < listRect.top) resultsList.scrollTop -= listRect.top - optionRect.top;
      else if (optionRect.bottom > listRect.bottom) {
        resultsList.scrollTop += optionRect.bottom - listRect.bottom;
      }
    } else input.removeAttribute("aria-activedescendant");
  }

  function navigate(entry: Entry): void {
    close();
    const navigationScope = scope.value === "selected"
      ? selectedBrainIds
      : scope.value === "active" && activeBrainId ? [activeBrainId] : [];
    const canRetainFocus = !workspace || scope.value === "selected" || (
      scope.value === "active" && selectedBrainIds.length === 0
    );
    const focus = canRetainFocus ? document.documentElement.dataset.originatingGraphFocus : undefined;
    const scoped = entry.kind === "note" && (navigationScope.length > 0 || focus)
      ? withGraphContext(brainRegistry, focus ? [focus] : [], entry.route, navigationScope, focus)
      : null;
    const route = scoped?.valid ? scoped.route : entry.route;
    window.location.assign(joinBase(import.meta.env.BASE_URL, route));
  }

  async function search(): Promise<void> {
    await ensureIndex();
    const q = input.value.trim();
    const scoped = entries!.filter((entry) => {
      if (scope.value === "active") return entry.brainId === activeBrainId;
      if (scope.value === "selected") return selectedBrainIds.includes(entry.brainId);
      return true;
    });
    if (!q) {
      renderResults(scoped);
      return;
    }
    const allowed = new Set(scoped);
    renderResults(fuse!.search(q).map((result) => result.item).filter((entry) => allowed.has(entry)));
  }

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
      e.preventDefault();
      if (overlay.hidden) open();
      else close();
    } else if (!overlay.hidden && e.key === "Escape") {
      e.stopImmediatePropagation();
      close();
    } else if (!overlay.hidden && e.key === "Tab") {
      const controls = [scope, input].filter((control) => control.offsetParent !== null);
      const first = controls[0];
      const last = controls.at(-1);
      if (e.shiftKey && document.activeElement === first) {
        e.preventDefault();
        last?.focus();
      } else if (!e.shiftKey && document.activeElement === last) {
        e.preventDefault();
        first?.focus();
      }
    }
  });

  document.querySelectorAll("[data-open-switcher]").forEach((el) =>
    el.addEventListener("click", open),
  );

  overlay.addEventListener("click", (e) => {
    if (e.target === overlay) close();
  });

  input.addEventListener("input", () => void search());
  scope.addEventListener("change", () => void search());
  document.addEventListener("brain-selection-change", (event) => {
    selectedBrainIds = [...(event as CustomEvent<{ brainIds: readonly string[] }>).detail.brainIds];
    if (!overlay.hidden && scope.value === "selected") void search();
  });
  input.addEventListener("keydown", (e) => {
    if (e.key === "ArrowDown") {
      e.preventDefault();
      select(Math.min(selected + 1, Math.min(results.length, 10) - 1));
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      select(Math.max(selected - 1, 0));
    } else if (e.key === "Enter") {
      e.preventDefault();
      const entry = results[selected];
      if (entry) navigate(entry);
    }
  });
</script>
