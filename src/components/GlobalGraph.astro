---
import { getLinkIndex } from "../lib/link-index";
import { getWorkspaceSnapshot } from "../lib/vault-state";
import BrainMark from "./BrainMark.astro";
import GraphLegend from "./GraphLegend.astro";

interface Props { activeBrainId?: string; combined?: boolean }
const { activeBrainId, combined = false } = Astro.props;
const index = getLinkIndex();
const snapshot = getWorkspaceSnapshot();
const isWorkspace = snapshot.mode === "workspace";
const allTags = [...new Set(index.notes.flatMap((note) => note.meta.tags))].sort();
const typeCounts = new Map<string, number>();
for (const note of index.notes) {
  typeCounts.set(note.meta.type, (typeCounts.get(note.meta.type) ?? 0) + 1);
}
const activeBrain = activeBrainId
  ? snapshot.registry.brains.find((brain) => brain.id === activeBrainId)
  : undefined;
const boundaryBrainIds = new Set<string>();
if (activeBrainId) {
  for (const edge of index.edges) {
    if (!edge.crossBrain) continue;
    if (edge.sourceBrainId === activeBrainId) boundaryBrainIds.add(edge.targetBrainId);
    if (edge.targetBrainId === activeBrainId) boundaryBrainIds.add(edge.sourceBrainId);
  }
}
const legendBrains = snapshot.registry.brains.filter((brain) =>
  combined || brain.id === activeBrainId || boundaryBrainIds.has(brain.id)
);
const contextActionLabel = activeBrain
  ? `Brain context: ${activeBrain.title}`
  : combined ? "Brain context: combined brains" : "Brain context: Brain chooser";
const brainRouteRegistry = snapshot.registry.brains.map(({ id, title }) => ({ id, title }));
---

<div class="graph-page">
  <div class:list={["graph-shell", "filters-closed", { "has-related-brains": activeBrainId && boundaryBrainIds.size > 0 }]}>
    <div class="graph-controls">
      <button
        id="graph-filter-toggle"
        class="graph-control graph-filter-toggle"
        type="button"
        aria-label="Filters"
        title="Filters"
        aria-controls="graph-sidebar"
        aria-expanded="false"
      >
        <svg class="graph-control-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 6h16M7 12h10M10 18h4"></path>
        </svg>
        <span class="graph-control-label" data-control-label>Filters</span>
      </button>
      <button id="graph-fit-view" class="graph-control" type="button" aria-label="Fit view" title="Fit view">
        <svg class="graph-control-icon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M9 4H4v5M15 4h5v5M20 15v5h-5M4 15v5h5"></path>
        </svg>
        <span class="graph-control-label">Fit view</span>
      </button>
      {activeBrainId && boundaryBrainIds.size > 0 && (
        <button
          id="graph-related-toggle"
          class="graph-control graph-related-toggle"
          type="button"
          aria-label="Show related brains"
          title="Show related brains"
          aria-pressed="false"
        >
          <svg class="graph-control-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="7" cy="12" r="3"></circle>
            <circle cx="17" cy="7" r="3"></circle>
            <circle cx="17" cy="17" r="3"></circle>
            <path d="m9.7 10.7 4.5-2.3M9.7 13.3l4.5 2.3"></path>
          </svg>
          <span class="graph-control-label" data-control-label>Show related brains</span>
        </button>
      )}
      <GraphLegend
        id="global-graph-legend"
        context={combined ? "combined" : activeBrainId ? "brain" : "global"}
        brains={legendBrains}
        activeBrainId={activeBrainId}
        globalControl
      />
      {isWorkspace && (
        <details
          class="context-switcher"
          data-registry={JSON.stringify(brainRouteRegistry)}
          data-active-brain-id={activeBrainId}
          data-combined={combined ? "true" : "false"}
        >
          <summary
            role="button"
            aria-label={contextActionLabel}
            aria-expanded="false"
            title={contextActionLabel}
            style={activeBrain ? `--brain-accent: ${activeBrain.accent}` : undefined}
          >
            <span class="context-switcher__mark">
              <BrainMark />
              <span class="context-switcher__satellite" hidden={!combined} aria-hidden="true"></span>
            </span>
          </summary>
          <form class="context-switcher__panel">
            <fieldset>
              <legend>Brain context</legend>
              {snapshot.registry.brains.map((brain) => (
                <label style={`--brain-accent: ${brain.accent}`}>
                  <input type="checkbox" name="brain-context" value={brain.id} checked={brain.id === activeBrainId} />
                  <BrainMark />
                  <span class="context-switcher__label" title={`@${brain.id}`}>@{brain.id}</span>
                </label>
              ))}
            </fieldset>
            <button type="submit">Apply</button>
          </form>
        </details>
      )}
    </div>
    <aside id="graph-sidebar" class="graph-sidebar" inert>
      <h2>Search</h2>
      <input id="graph-search" type="search" placeholder="Find a note..." autocomplete="off" />
      <ul id="graph-search-results" class="graph-search-results"></ul>

      <h2>Type</h2>
      {(["fleeting", "literature", "permanent"] as const).map((type) => (
        <label>
          <input type="checkbox" data-filter="type" value={type} checked />
          <span>{type}</span>
          <span class="facet-count">{typeCounts.get(type) ?? 0}</span>
        </label>
      ))}

      <h2>Status</h2>
      {(["draft", "developing", "established"] as const).map((status) => (
        <label>
          <input type="checkbox" data-filter="status" value={status} checked />
          <span>{status}</span>
        </label>
      ))}

      <h2>Tag</h2>
      <select id="graph-tag-filter">
        <option value="">All tags</option>
        {allTags.map((tag) => <option value={tag}>{tag}</option>)}
      </select>

      <h2>Legend</h2>
      <div class="graph-legend" data-graph-legend>
        <p>
          {combined
            ? "Brain accents and @brain labels identify ownership."
            : "Local node color is note type. Related foreign nodes are smaller and gray, with ↗ and an @brain label."}
        </p>
        <ul class="graph-brain-key" aria-label="Brain identity legend">
          {legendBrains.map((brain, index) => (
            <li style={`--brain-accent: ${brain.accent}`} data-brain-key={brain.id}>
              <span class={`brain-shape brain-shape--${index % 4}`} aria-hidden="true"></span>
              <span>@{brain.id}: {brain.title}</span>
              {brain.id !== activeBrainId && activeBrain && <span class="foreign-key">foreign ↗</span>}
            </li>
          ))}
        </ul>
        <p><span aria-hidden="true">○</span> draft, <span aria-hidden="true">◇</span> developing, <span aria-hidden="true">◆</span> established</p>
        <p>
          <span class:list={["cross-edge-key", { "cross-edge-key--muted": !combined }]} aria-hidden="true"></span>
          {combined ? "thick line: cross-brain link" : "muted line: cross-brain link"}
        </p>
        <p>Node size shows connections. Hover to inspect a neighborhood; drag to rearrange; click to open.</p>
      </div>

      <p id="graph-count" class="graph-count"></p>
    </aside>
    <div class="graph-container">
      <section class="graph-focus-status" data-graph-focus-status hidden aria-label="Focused graph neighborhood">
        <span>Focused: <strong data-graph-focus-title></strong></span>
        <div>
          <button type="button" data-graph-focus-copy>Copy link</button>
          <a data-graph-focus-open>Open note</a>
          <button type="button" data-graph-focus-clear>Clear</button>
        </div>
      </section>
      <div class="graph-context-menu" data-graph-context-menu role="menu" hidden>
        <button type="button" role="menuitem" data-graph-menu-focus>Pin neighborhood</button>
        <button type="button" role="menuitem" data-graph-menu-copy>Copy neighborhood link</button>
        <button type="button" role="menuitem" data-graph-menu-open>Open note</button>
      </div>
      <div
        id="global-graph"
        class="graph-host"
        data-graph-mode={combined ? "combined" : activeBrainId ? "brain" : "all"}
        data-active-brain-id={activeBrainId}
        aria-label={combined ? "Combined brain graph" : activeBrain ? `${activeBrain.title} graph` : "Brain graph"}
      ></div>
    </div>
  </div>
</div>

<script>
  import { mountGlobalGraph } from "../lib/graph-view";
  import { brainSelectionContext, joinBase, singularQueryValue, type BrainSelectionContext } from "../lib/routes";

  const q = <T extends Element>(selector: string): T => {
    const element = document.querySelector<T>(selector);
    if (!element) throw new Error(`graph page: missing ${selector}`);
    return element;
  };
  const graphShell = q<HTMLElement>(".graph-shell");
  const filterToggle = q<HTMLButtonElement>("#graph-filter-toggle");
  const sidebar = q<HTMLElement>("#graph-sidebar");
  const filterStateKey = "brain:graph-filters-open";
  const graphFilterStateKey = "brain:graph-filter-values";
  const typeFilters = document.querySelectorAll<HTMLInputElement>('[data-filter="type"]');
  const statusFilters = document.querySelectorAll<HTMLInputElement>('[data-filter="status"]');
  const tagFilter = q<HTMLSelectElement>("#graph-tag-filter");
  const context = document.querySelector<HTMLDetailsElement>(".graph-controls > .context-switcher");

  function setFiltersOpen(open: boolean, persist = true): void {
    if (open && context?.open) context.open = false;
    sidebar.classList.toggle("is-open", open);
    sidebar.inert = !open;
    graphShell.classList.toggle("filters-closed", !open);
    filterToggle.setAttribute("aria-expanded", String(open));
    const label = open ? "Close filters" : "Filters";
    filterToggle.setAttribute("aria-label", label);
    filterToggle.title = label;
    filterToggle.querySelector<HTMLElement>("[data-control-label]")!.textContent = label;
    if (open) document.dispatchEvent(new CustomEvent("graph-legend-close"));
    if (persist) {
      try {
        sessionStorage.setItem(filterStateKey, String(open));
      } catch {
        // The control remains usable when storage is unavailable.
      }
    }
  }

  function restoreFiltersOpen(): boolean {
    try {
      return sessionStorage.getItem(filterStateKey) === "true";
    } catch {
      return false;
    }
  }

  function persistGraphFilters(): void {
    try {
      sessionStorage.setItem(graphFilterStateKey, JSON.stringify({
        types: [...typeFilters].filter((control) => control.checked).map((control) => control.value),
        statuses: [...statusFilters].filter((control) => control.checked).map((control) => control.value),
        tag: tagFilter.value,
      }));
    } catch {
      // Filters remain usable without persistence.
    }
  }

  function restoreGraphFilters(): void {
    try {
      const raw = sessionStorage.getItem(graphFilterStateKey);
      if (!raw) return;
      const state = JSON.parse(raw) as { types?: unknown; statuses?: unknown; tag?: unknown };
      if (Array.isArray(state.types) && state.types.every((value) => typeof value === "string")) {
        for (const control of typeFilters) control.checked = state.types.includes(control.value);
      }
      if (Array.isArray(state.statuses) && state.statuses.every((value) => typeof value === "string")) {
        for (const control of statusFilters) control.checked = state.statuses.includes(control.value);
      }
      if (typeof state.tag === "string" && [...tagFilter.options].some((option) => option.value === state.tag)) {
        tagFilter.value = state.tag;
      }
    } catch {
      // Ignore unavailable or malformed stored state.
    }
  }

  filterToggle.addEventListener("click", () => {
    setFiltersOpen(filterToggle.getAttribute("aria-expanded") !== "true");
  });
  document.addEventListener("graph-legend-open", () => {
    if (context?.open) context.open = false;
    if (filterToggle.getAttribute("aria-expanded") === "true") setFiltersOpen(false);
  });
  document.addEventListener("keydown", (event) => {
    if (document.querySelector("#quick-switcher:not([hidden])")) return;
    if (event.key === "Escape" && filterToggle.getAttribute("aria-expanded") === "true") {
      setFiltersOpen(false);
      filterToggle.focus();
    }
  });
  setFiltersOpen(restoreFiltersOpen(), false);
  restoreGraphFilters();
  for (const control of [...typeFilters, ...statusFilters]) {
    control.addEventListener("change", persistGraphFilters);
  }
  tagFilter.addEventListener("change", persistGraphFilters);

  if (context) {
    const summary = context.querySelector<HTMLElement>(":scope > summary")!;
    const form = context.querySelector<HTMLFormElement>("form")!;
    const controls = [...form.querySelectorAll<HTMLInputElement>('input[name="brain-context"]')];
    const satellite = summary.querySelector<HTMLElement>(".context-switcher__satellite")!;
    const registry = JSON.parse(context.dataset.registry ?? "[]") as { id: string; title: string }[];
    const activeBrainId = context.dataset.activeBrainId;
    const query = singularQueryValue(new URLSearchParams(window.location.search), "brains");
    const initialInput = context.dataset.combined === "true" && query.valid && query.present
      ? query.value
      : activeBrainId ? [activeBrainId] : [];
    let current = brainSelectionContext(registry, initialInput);

    const updateContext = (selection: BrainSelectionContext) => {
      if (!selection.valid) return;
      current = selection;
      const label = selection.kind === "chooser"
        ? "Brain context: Brain chooser"
        : selection.kind === "combined"
          ? `Brain context: ${selection.brainIds.length} brains combined`
          : `Brain context: ${registry.find((brain) => brain.id === selection.brainIds[0])?.title ?? selection.brainIds[0]}`;
      summary.setAttribute("aria-label", label);
      summary.title = label;
      satellite.hidden = selection.kind !== "combined";
    };
    const resetControls = () => {
      if (!current.valid) return;
      for (const control of controls) control.checked = current.brainIds.includes(control.value);
    };
    context.addEventListener("toggle", () => {
      summary.setAttribute("aria-expanded", String(context.open));
      if (context.open) {
        if (filterToggle.getAttribute("aria-expanded") === "true") setFiltersOpen(false);
        document.dispatchEvent(new CustomEvent("graph-legend-close"));
        resetControls();
      }
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      const selection = brainSelectionContext(
        registry,
        controls.filter((control) => control.checked).map((control) => control.value),
      );
      if (!selection.valid) return;
      const target = joinBase(import.meta.env.BASE_URL, selection.graph);
      if (selection.kind === "combined" && context.dataset.combined === "true") {
        window.history.replaceState(null, "", target);
        updateContext(selection);
        context.open = false;
        document.dispatchEvent(new CustomEvent("brain-selection-change", { detail: selection }));
      } else {
        window.location.assign(target);
      }
    });
    document.addEventListener("pointerdown", (event) => {
      if (context.open && event.target instanceof Node && !context.contains(event.target)) {
        context.open = false;
      }
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && context.open) {
        event.stopImmediatePropagation();
        context.open = false;
        summary.focus();
      }
    });
    updateContext(current);
  }

  mountGlobalGraph({
    host: q("#global-graph"),
    searchInput: q<HTMLInputElement>("#graph-search"),
    searchResults: q("#graph-search-results"),
    typeFilters,
    statusFilters,
    tagFilter,
    count: q("#graph-count"),
    fitViewButton: q<HTMLButtonElement>("#graph-fit-view"),
    relatedBrainsToggle: document.querySelector<HTMLButtonElement>("#graph-related-toggle"),
    focusStatus: q("[data-graph-focus-status]"),
    focusTitle: q("[data-graph-focus-title]"),
    focusCopy: q<HTMLButtonElement>("[data-graph-focus-copy]"),
    focusOpen: q<HTMLAnchorElement>("[data-graph-focus-open]"),
    focusClear: q<HTMLButtonElement>("[data-graph-focus-clear]"),
    contextMenu: q("[data-graph-context-menu]"),
    contextFocus: q<HTMLButtonElement>("[data-graph-menu-focus]"),
    contextCopy: q<HTMLButtonElement>("[data-graph-menu-copy]"),
    contextOpen: q<HTMLButtonElement>("[data-graph-menu-open]"),
  }).catch((error) => console.error("[graph] failed to mount", error));
</script>
