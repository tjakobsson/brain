---
import { BRAIN_MARK_PATH } from "../lib/brain-mark";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class:list={["brain-mark", className]}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  data-brain-mark
>
  <path d={BRAIN_MARK_PATH} />
</svg>
