---
import BaseLayout from "../layouts/BaseLayout.astro";
import { joinBase, routes } from "../lib/routes";
import { getWorkspaceSnapshot } from "../lib/vault-state";

interface Props { brainId?: string; combined?: boolean }
const { brainId } = Astro.props;
const snapshot = getWorkspaceSnapshot();
const combined = snapshot.mode === "workspace" && brainId === undefined;
const pagefindCss = joinBase(import.meta.env.BASE_URL, routes.pagefindUiCss);
const registry = snapshot.registry.brains.map(({ id, title }) => ({ id, title }));
---

<BaseLayout title="Search" activeBrainId={brainId} combined={combined}>
  <div class="search-page">
    <h1>Search</h1>
    {snapshot.mode === "workspace" && (
      <label class="search-scope">
        <span>Search scope</span>
        <select
          id="search-scope"
          data-active-brain-id={brainId}
          data-combined={combined ? "true" : "false"}
          data-registry={JSON.stringify(registry)}
        >
          {brainId && <option value="active">Active brain @{brainId}</option>}
          {combined && <option value="selected">Selected brains</option>}
          <option value="all">All brains</option>
        </select>
      </label>
    )}
    <form id="search-box" class="pagefind-ui" role="search" aria-label="Search this site">
      <label class="visually-hidden" for="pagefind-search-input">Search</label>
      <input
        id="pagefind-search-input"
        class="pagefind-ui__search-input"
        type="search"
        autocomplete="off"
        placeholder="Search this site"
      />
      <p class="pagefind-ui__message" data-search-message aria-live="polite"></p>
      <ol class="pagefind-ui__results" data-search-results></ol>
    </form>
    <p id="search-unavailable" hidden>
      The full-text index only exists after a production build. Run
      <code>npm run build</code> then <code>npm run preview</code>. The Cmd+K quick
      switcher works everywhere, including dev.
    </p>
  </div>

  <link href={pagefindCss} rel="stylesheet" />
  <script>
    import { joinBase, routes } from "../lib/routes";

    window.addEventListener("DOMContentLoaded", async () => {
      const pagefindApi = joinBase(import.meta.env.BASE_URL, `${routes.pagefind}pagefind.js`);
      const probe = await fetch(pagefindApi, { method: "HEAD" });
      if (!probe.ok) {
        document.getElementById("search-unavailable")!.hidden = false;
        return;
      }
      const pagefind = await import(/* @vite-ignore */ pagefindApi);
      const scope = document.querySelector<HTMLSelectElement>("#search-scope");
      const form = document.querySelector<HTMLFormElement>("#search-box")!;
      const input = form.querySelector<HTMLInputElement>(".pagefind-ui__search-input")!;
      const message = form.querySelector<HTMLElement>("[data-search-message]")!;
      const results = form.querySelector<HTMLOListElement>("[data-search-results]")!;
      const selectedBrainIds = scope?.dataset.combined === "true"
        ? (new URLSearchParams(window.location.search).get("brains") ?? "").split(",").filter(Boolean)
        : [];
      if (scope?.value === "selected" && selectedBrainIds.length < 2) scope.value = "all";
      await pagefind.options({ baseUrl: joinBase(import.meta.env.BASE_URL, routes.home) });
      let generation = 0;

      const filters = () => {
        if (!scope || scope.value === "all") return undefined;
        if (scope.value === "active") return { brain: scope.dataset.activeBrainId };
        return { brain: { any: selectedBrainIds } };
      };

      const render = async () => {
        const current = ++generation;
        const term = input.value.trim();
        results.innerHTML = "";
        if (!term) {
          message.textContent = "";
          return;
        }
        message.textContent = "Searching...";
        const response = await pagefind.search(term, { filters: filters() });
        const entries = await Promise.all(response.results.map((result) => result.data()));
        if (current !== generation) return;
        message.textContent = `${entries.length} ${entries.length === 1 ? "result" : "results"} for ${term}`;
        for (const entry of entries) {
          const item = document.createElement("li");
          item.className = "pagefind-ui__result";
          const heading = document.createElement("h2");
          heading.className = "pagefind-ui__result-title";
          const link = document.createElement("a");
          link.className = "pagefind-ui__result-link";
          link.href = entry.url;
          const owner = entry.meta.brainId;
          link.textContent = owner ? `${entry.meta.title} · @${owner}` : entry.meta.title;
          heading.append(link);
          const excerpt = document.createElement("p");
          excerpt.className = "pagefind-ui__result-excerpt";
          excerpt.innerHTML = entry.excerpt;
          item.append(heading, excerpt);
          results.append(item);
        }
      };
      form.addEventListener("submit", (event) => event.preventDefault());
      input.addEventListener("input", () => void render());
      scope?.addEventListener("change", () => void render());
    });
  </script>
</BaseLayout>
