---
import "../styles/global.css";
import QuickSwitcher from "../components/QuickSwitcher.astro";
import { joinBase, routes } from "../lib/routes";

interface Props {
  title: string;
  wide?: boolean;
  /** Full-bleed pages (graph): no max-width, no padding. */
  fluid?: boolean;
  compactHeader?: boolean;
}

const { title, wide = false, fluid = false, compactHeader = false } = Astro.props;
const url = (route: import("../lib/routes").LogicalRoute) => joinBase(import.meta.env.BASE_URL, route);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={url(routes.faviconSvg)} />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["site-header-slot", { "has-floating-header": compactHeader }]}>
      <header class="site-header" data-scroll-compact={compactHeader ? "" : undefined}>
        <nav class="site-nav" aria-label="Primary navigation">
          <a href={url(routes.home)}>Graph</a>
          <a href={url(routes.tags)}>Tags</a>
          <a href={url(routes.recent)}>Recent</a>
          <a href={url(routes.orphans)}>Orphans</a>
          <a href={url(routes.search)}>Search</a>
        </nav>
        <details class="mobile-nav">
          <summary aria-label="Site navigation">
            <span class="menu-icon" aria-hidden="true"></span>
          </summary>
          <nav class="mobile-nav-panel" aria-label="Site navigation">
            <a href={url(routes.home)}>Graph</a>
            <a href={url(routes.tags)}>Tags</a>
            <a href={url(routes.recent)}>Recent</a>
            <a href={url(routes.orphans)}>Orphans</a>
            <a href={url(routes.search)}>Search</a>
          </nav>
        </details>
        <button
          class="search-trigger"
          data-open-switcher
          type="button"
          aria-label="Search"
          aria-haspopup="dialog"
          aria-controls="quick-switcher"
        >
          <span class="search-label">Search</span>
          <svg class="search-icon" viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="11" cy="11" r="6.5"></circle>
            <path d="m16 16 4 4"></path>
          </svg>
          <kbd>⌘K</kbd>
        </button>
      </header>
    </div>
    <main class:list={[{ wide, fluid }]}>
      <slot />
    </main>
    <QuickSwitcher />
    <script>
      const compactHeader = document.querySelector<HTMLElement>("[data-scroll-compact]");
      if (compactHeader) {
        const menu = compactHeader.querySelector<HTMLDetailsElement>(".mobile-nav");
        let previousY = Math.max(window.scrollY, 0);
        let direction = 0;
        let distance = 0;
        let frame: number | null = null;

        const reconcileHeader = (ignoreFocus = false) => {
          if (!ignoreFocus && (compactHeader.matches(":focus-within") || menu?.open)) return;
          if (window.scrollY <= 80 || (direction < 0 && distance >= 16)) {
            compactHeader.classList.remove("is-compact");
          } else if (direction > 0 && distance >= 24) {
            compactHeader.classList.add("is-compact");
          }
        };

        const updateHeader = () => {
          frame = null;
          const currentY = Math.max(window.scrollY, 0);
          const delta = currentY - previousY;
          const nextDirection = Math.sign(delta);
          const interacting = compactHeader.matches(":focus-within") || menu?.open;

          if (nextDirection !== 0) {
            if (nextDirection !== direction) distance = 0;
            direction = nextDirection;
            distance += Math.abs(delta);
          }

          if (currentY <= 80 && !interacting) {
            compactHeader.classList.remove("is-compact");
            distance = 0;
          } else if (!interacting && nextDirection !== 0) {
            if (direction > 0 && distance >= 24) compactHeader.classList.add("is-compact");
            if (direction < 0 && distance >= 16) compactHeader.classList.remove("is-compact");
          }
          previousY = currentY;
        };

        window.addEventListener(
          "scroll",
          () => {
            if (frame === null) frame = requestAnimationFrame(updateHeader);
          },
          { passive: true },
        );
        if (previousY > 80) compactHeader.classList.add("is-compact");
        compactHeader.addEventListener("focusout", () => window.setTimeout(reconcileHeader, 0));
        menu?.addEventListener("toggle", () => {
          if (menu.open) return;
          const focusWasInMenu = menu.contains(document.activeElement);
          reconcileHeader(true);
          if (focusWasInMenu && menu.offsetParent === null) {
            compactHeader.querySelector<HTMLElement>(".search-trigger")?.focus();
          }
        });
      }
    </script>
  </body>
</html>
