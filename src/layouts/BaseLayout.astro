---
import "../styles/global.css";
import QuickSwitcher from "../components/QuickSwitcher.astro";
import { joinBase, routes, routesFor } from "../lib/routes";
import { getWorkspaceSnapshot } from "../lib/vault-state";

interface Props {
  title: string;
  wide?: boolean;
  /** Full-bleed pages (graph): no max-width, no padding. */
  fluid?: boolean;
  activeBrainId?: string;
  combined?: boolean;
}

const { title, wide = false, fluid = false, activeBrainId, combined = false } = Astro.props;
const snapshot = getWorkspaceSnapshot();
const isWorkspace = snapshot.mode === "workspace";
const activeBrain = activeBrainId
  ? snapshot.registry.brains.find((brain) => brain.id === activeBrainId)
  : undefined;
if (isWorkspace && activeBrainId && !activeBrain) {
  throw new Error(`Unknown active brain ${JSON.stringify(activeBrainId)}.`);
}
const contextualRoutes = activeBrain
  ? routesFor({ mode: "workspace", brainId: activeBrain.id })
  : routesFor({ mode: "vault" });
const graphRoute = activeBrain ? contextualRoutes.graph : combined ? routes.graphAlias : routes.home;
const hasGraphRoute = !isWorkspace || Boolean(activeBrain) || combined;
const hasContextReports = !isWorkspace || Boolean(activeBrain);
const url = (route: import("../lib/routes").LogicalRoute) => joinBase(import.meta.env.BASE_URL, route);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={url(routes.faviconSvg)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-header-slot">
      <header class="site-header">
        <nav class="site-nav-pill" aria-label="Primary navigation">
          <div class="nav-menu-pill">
            <button
              class="nav-action nav-launcher"
              type="button"
              aria-label="Navigation"
              title="Navigation"
              aria-controls="nav-actions"
              aria-expanded="false"
            >
              <svg class="nav-icon launcher-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="8" cy="8" r="1.5"></circle>
                <circle cx="16" cy="8" r="1.5"></circle>
                <circle cx="8" cy="16" r="1.5"></circle>
                <circle cx="16" cy="16" r="1.5"></circle>
              </svg>
            </button>
            <div id="nav-actions" class="nav-actions" inert aria-hidden="true">
            <a
              class="nav-action graph-trigger"
              href={url(graphRoute)}
              aria-label="Graph"
              title="Graph"
              data-combined-route={combined ? "" : undefined}
              data-combined-graph-route={combined ? "" : undefined}
              hidden={!hasGraphRoute || combined}
            >
              <svg class="nav-icon graph-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M7.5 7.5 12 5l4.5 2.5v5L12 15l-4.5-2.5z"></path>
                <path d="M7.5 12.5 5 17m11.5-4.5L19 17M12 15v4"></path>
                <circle cx="5" cy="17" r="1.5"></circle>
                <circle cx="19" cy="17" r="1.5"></circle>
                <circle cx="12" cy="20" r="1.5"></circle>
              </svg>
            </a>
            <button
              class="nav-action search-trigger"
              data-open-switcher
              type="button"
              aria-label="Search"
              title="Search"
              aria-haspopup="dialog"
              aria-controls="quick-switcher"
            >
              <svg class="nav-icon search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="m16 16 4 4"></path>
              </svg>
            </button>
            {hasContextReports && (
              <a class="nav-action nav-direct-action" href={url(contextualRoutes.tags)} aria-label="Tags" title="Tags">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 5.5V11l8.5 8.5 7-7L11 4H5.5A1.5 1.5 0 0 0 4 5.5Z"></path>
                  <circle cx="8" cy="8" r="1"></circle>
                </svg>
              </a>
            )}
            {hasContextReports && (
              <a class="nav-action nav-direct-action" href={url(contextualRoutes.recent)} aria-label="Recent" title="Recent">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="8"></circle>
                  <path d="M12 7v5l3.5 2"></path>
                </svg>
              </a>
            )}
            {hasContextReports && (
              <a class="nav-action nav-direct-action" href={url(contextualRoutes.orphans)} aria-label="Orphans" title="Orphans">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="8" cy="8" r="2.5"></circle>
                  <circle cx="16" cy="16" r="2.5"></circle>
                  <path d="m10 10 4 4" stroke-dasharray="2.5 2.5"></path>
                </svg>
              </a>
            )}
            </div>
          </div>
        </nav>
      </header>
    </div>
    <main class:list={[{ wide, fluid }]}>
      <slot />
    </main>
    <QuickSwitcher activeBrainId={activeBrainId} combined={combined} workspace={isWorkspace} />
    <script>
      import { joinBase, type BrainSelectionContext } from "../lib/routes";

      const header = document.querySelector<HTMLElement>(".site-header")!;
      const launcher = header.querySelector<HTMLButtonElement>(".nav-launcher")!;
      const actions = header.querySelector<HTMLElement>(".nav-actions")!;
      let expanded = false;

      const applyNavigationState = () => {
        header.toggleAttribute("data-nav-expanded", expanded);
        launcher.setAttribute("aria-expanded", String(expanded));
        actions.setAttribute("aria-hidden", String(!expanded));
        actions.inert = !expanded;
        actions.style.setProperty("--nav-actions-height", `${actions.scrollHeight}px`);
      };
      const collapseNavigation = (restoreFocus: boolean) => {
        if (!expanded) return;
        expanded = false;
        for (const details of actions.querySelectorAll<HTMLDetailsElement>("details[open]")) {
          details.open = false;
        }
        applyNavigationState();
        if (restoreFocus) launcher.focus();
      };

      launcher.addEventListener("click", () => {
        if (expanded) {
          collapseNavigation(false);
          return;
        }
        expanded = true;
        applyNavigationState();
      });
      actions.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest(".search-trigger")) collapseNavigation(true);
        else if (target?.closest("a")) collapseNavigation(false);
      }, { capture: true });
      document.addEventListener("pointerdown", (event) => {
        if (expanded && event.target instanceof Node && !header.contains(event.target)) {
          collapseNavigation(false);
          const interactiveTarget = event.target instanceof Element && event.target.closest(
            'a[href], button, input, select, textarea, summary, [contenteditable="true"], [tabindex]:not([tabindex="-1"])',
          );
          if (!interactiveTarget) window.setTimeout(() => launcher.focus(), 0);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && expanded) {
          event.stopImmediatePropagation();
          collapseNavigation(true);
        }
      });
      new ResizeObserver(applyNavigationState).observe(actions);
      applyNavigationState();
      const combinedGraph = header.querySelector<HTMLAnchorElement>("[data-combined-graph-route]");
      if (combinedGraph) {
        combinedGraph.setAttribute("href", `${window.location.pathname}${window.location.search}`);
      }
      document.addEventListener("brain-selection-change", (event) => {
        const selection = (event as CustomEvent<BrainSelectionContext>).detail;
        if (combinedGraph && selection.valid && selection.kind === "combined") {
          combinedGraph.href = joinBase(import.meta.env.BASE_URL, selection.graph);
        }
      });
    </script>
  </body>
</html>
