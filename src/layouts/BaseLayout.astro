---
import "../styles/global.css";
import QuickSwitcher from "../components/QuickSwitcher.astro";
import packageMetadata from "../../package.json";
import { joinBase, routes, routesFor, type LogicalRoute } from "../lib/routes";
import { getWorkspaceSnapshot } from "../lib/vault-state";

interface Props {
  title: string;
  wide?: boolean;
  /** Full-bleed pages (graph): no max-width, no padding. */
  fluid?: boolean;
  activeBrainId?: string;
  noteContext?: { ownerBrainId: string; compositeId: string; neighborhoodRoute: LogicalRoute };
}

const {
  title,
  wide = false,
  fluid = false,
  activeBrainId,
  noteContext,
} = Astro.props;
const snapshot = getWorkspaceSnapshot();
const isWorkspace = snapshot.mode === "workspace";
const activeBrain = activeBrainId
  ? snapshot.registry.brains.find((brain) => brain.id === activeBrainId)
  : undefined;
if (isWorkspace && activeBrainId && !activeBrain) {
  throw new Error(`Unknown active brain ${JSON.stringify(activeBrainId)}.`);
}
const contextualRoutes = activeBrain
  ? routesFor({ mode: "workspace", brainId: activeBrain.id })
  : routesFor({ mode: "vault" });
const baseGraphRoute = activeBrain ? contextualRoutes.graph : routes.home;
// A note page's Graph action opens the note's own neighborhood page unless
// valid in-session return context redirects it client-side to the originating
// note's neighborhood page. Both are pathname-only destinations.
const noteGraphRoute = noteContext?.neighborhoodRoute ?? baseGraphRoute;
const hasGraphRoute = !isWorkspace || Boolean(activeBrain);
const hasContextReports = !isWorkspace || Boolean(activeBrain);
const hasNoteNavigation = isWorkspace && Boolean(noteContext) && !fluid;
const url = (route: LogicalRoute) => joinBase(import.meta.env.BASE_URL, route);
const brainRegistry = snapshot.registry.brains.map(({ id, title }) => ({ id, title }));
const generatorLabel = `Brain v${packageMetadata.version}`;
---

<!doctype html>
<html
  lang="en"
  data-brain-registry={JSON.stringify(brainRegistry)}
  data-note-focus={noteContext?.compositeId}
  data-note-owner={noteContext?.ownerBrainId}
  data-note-neighborhood={noteContext?.neighborhoodRoute}
  data-workspace-mode={isWorkspace ? "true" : "false"}
>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={generatorLabel} />
    <slot name="head" />
    <link rel="icon" type="image/svg+xml" href={url(routes.faviconSvg)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-header-slot">
      {isWorkspace && !fluid && !hasNoteNavigation && (
        <a class="page-home-action nav-action" href={url(routes.home)} aria-label="Home" title="Home">
          <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1Z"></path>
          </svg>
        </a>
      )}
      {hasNoteNavigation && (
        <nav class="page-note-nav" aria-label="Note navigation">
          <a class="nav-action" href={url(routes.home)} aria-label="Home" title="Home">
            <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="m4 10 8-6 8 6v9a1 1 0 0 1-1 1h-5v-6h-4v6H5a1 1 0 0 1-1-1Z"></path>
            </svg>
          </a>
          <a
            class="nav-action note-graph-trigger"
            href={url(noteGraphRoute)}
            aria-label="Graph"
            title="Graph"
            data-scoped-graph-route
          >
            <svg class="nav-icon graph-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7.5 7.5 12 5l4.5 2.5v5L12 15l-4.5-2.5z"></path>
              <path d="M7.5 12.5 5 17m11.5-4.5L19 17M12 15v4"></path>
              <circle cx="5" cy="17" r="1.5"></circle>
              <circle cx="19" cy="17" r="1.5"></circle>
              <circle cx="12" cy="20" r="1.5"></circle>
            </svg>
          </a>
        </nav>
      )}
      <header class="site-header">
        <nav class="site-nav-pill" aria-label="Primary navigation">
          <div class="nav-menu-pill">
            <button
              class="nav-action nav-launcher"
              type="button"
              aria-label="Navigation"
              title="Navigation"
              aria-controls="nav-actions"
              aria-expanded="false"
            >
              <svg class="nav-icon launcher-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="8" cy="8" r="1.5"></circle>
                <circle cx="16" cy="8" r="1.5"></circle>
                <circle cx="8" cy="16" r="1.5"></circle>
                <circle cx="16" cy="16" r="1.5"></circle>
              </svg>
            </button>
            <div id="nav-actions" class="nav-actions" inert aria-hidden="true">
            {!hasNoteNavigation && (
              <a
                class="nav-action graph-trigger"
                href={url(noteGraphRoute)}
                aria-label="Graph"
                title="Graph"
                data-scoped-graph-route={noteContext ? "" : undefined}
                hidden={!hasGraphRoute}
              >
                <svg class="nav-icon graph-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M7.5 7.5 12 5l4.5 2.5v5L12 15l-4.5-2.5z"></path>
                  <path d="M7.5 12.5 5 17m11.5-4.5L19 17M12 15v4"></path>
                  <circle cx="5" cy="17" r="1.5"></circle>
                  <circle cx="19" cy="17" r="1.5"></circle>
                  <circle cx="12" cy="20" r="1.5"></circle>
                </svg>
              </a>
            )}
            <button
              class="nav-action search-trigger"
              data-open-switcher
              type="button"
              aria-label="Search"
              title="Search"
              aria-haspopup="dialog"
              aria-controls="quick-switcher"
            >
              <svg class="nav-icon search-icon" viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="6.5"></circle>
                <path d="m16 16 4 4"></path>
              </svg>
            </button>
            {hasContextReports && (
              <a class="nav-action nav-direct-action" href={url(contextualRoutes.tags)} aria-label="Tags" title="Tags">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M4 5.5V11l8.5 8.5 7-7L11 4H5.5A1.5 1.5 0 0 0 4 5.5Z"></path>
                  <circle cx="8" cy="8" r="1"></circle>
                </svg>
              </a>
            )}
            {hasContextReports && (
              <a class="nav-action nav-direct-action" href={url(contextualRoutes.recent)} aria-label="Recent" title="Recent">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="12" cy="12" r="8"></circle>
                  <path d="M12 7v5l3.5 2"></path>
                </svg>
              </a>
            )}
            {hasContextReports && (
              <a class="nav-action nav-direct-action" href={url(contextualRoutes.orphans)} aria-label="Orphans" title="Orphans">
                <svg class="nav-icon" viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="8" cy="8" r="2.5"></circle>
                  <circle cx="16" cy="16" r="2.5"></circle>
                  <path d="m10 10 4 4" stroke-dasharray="2.5 2.5"></path>
                </svg>
              </a>
            )}
            </div>
          </div>
        </nav>
      </header>
    </div>
    <main class:list={[{ wide, fluid, "has-home": isWorkspace && !fluid }]}>
      <slot />
    </main>
    <QuickSwitcher
      activeBrainId={activeBrainId}
      workspace={isWorkspace}
      brainRegistry={brainRegistry}
    />
    <script>
      import {
        joinBase,
        routes,
        singularQueryValue,
        withGraphFocus,
        withoutGraphFocus,
        type LogicalRoute,
      } from "../lib/routes";
      import { normalizeGraphData } from "../lib/graph-data";
      import { noteGraphActionRoute } from "../lib/graph-neighborhood";

      const header = document.querySelector<HTMLElement>(".site-header")!;
      const launcher = header.querySelector<HTMLButtonElement>(".nav-launcher")!;
      const actions = header.querySelector<HTMLElement>(".nav-actions")!;
      let expanded = false;

      const applyNavigationState = () => {
        header.toggleAttribute("data-nav-expanded", expanded);
        launcher.setAttribute("aria-expanded", String(expanded));
        actions.setAttribute("aria-hidden", String(!expanded));
        actions.inert = !expanded;
        actions.style.setProperty("--nav-actions-height", `${actions.scrollHeight}px`);
      };
      const collapseNavigation = (restoreFocus: boolean) => {
        if (!expanded) return;
        expanded = false;
        for (const details of actions.querySelectorAll<HTMLDetailsElement>("details[open]")) {
          details.open = false;
        }
        applyNavigationState();
        if (restoreFocus) launcher.focus();
      };

      launcher.addEventListener("click", () => {
        if (expanded) {
          collapseNavigation(false);
          return;
        }
        expanded = true;
        applyNavigationState();
      });
      actions.addEventListener("click", (event) => {
        const target = event.target instanceof Element ? event.target : null;
        if (target?.closest(".search-trigger")) collapseNavigation(true);
        else if (target?.closest("a")) collapseNavigation(false);
      }, { capture: true });
      document.addEventListener("pointerdown", (event) => {
        if (expanded && event.target instanceof Node && !header.contains(event.target)) {
          collapseNavigation(false);
          const interactiveTarget = event.target instanceof Element && event.target.closest(
            'a[href], button, input, select, textarea, summary, [contenteditable="true"], [tabindex]:not([tabindex="-1"])',
          );
          if (!interactiveTarget) window.setTimeout(() => launcher.focus(), 0);
        }
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && expanded) {
          event.stopImmediatePropagation();
          collapseNavigation(true);
        }
      });
      new ResizeObserver(applyNavigationState).observe(actions);
      applyNavigationState();

      const noteOwner = document.documentElement.dataset.noteOwner;
      const workspaceMode = document.documentElement.dataset.workspaceMode === "true";
      const requestedFocus = singularQueryValue(new URLSearchParams(window.location.search), "focus");
      const clearInvalidFocus = () => {
        const current = `${window.location.pathname}${window.location.search}${window.location.hash}` as LogicalRoute;
        window.history.replaceState(null, "", withoutGraphFocus(current));
      };
      if (noteOwner && requestedFocus.present && !requestedFocus.valid) clearInvalidFocus();
      const ownNeighborhood = document.documentElement.dataset.noteNeighborhood as LogicalRoute | undefined;
      if (noteOwner && ownNeighborhood && requestedFocus.valid && requestedFocus.present) {
        // Return context names the note whose neighborhood the reader came
        // from. Resolve it against the whole graph so the Graph action becomes
        // that note's neighborhood page; unknown context degrades to this
        // note's own page. Either way the link is a pathname.
        const restoreOriginatingFocus = async () => {
          const response = await fetch(joinBase(import.meta.env.BASE_URL, routes.graphData));
          if (!response.ok) throw new Error(`Graph data request failed: ${response.status}`);
          const data = normalizeGraphData(await response.json());
          const knownCompositeIds = data.nodes.map(({ compositeId }) => compositeId);
          if (!knownCompositeIds.includes(requestedFocus.value)) {
            clearInvalidFocus();
            return;
          }
          const mode = workspaceMode ? "workspace" : "vault";
          const graphRoute = noteGraphActionRoute(ownNeighborhood, requestedFocus.value, data.nodes, mode);
          document.documentElement.dataset.originatingGraphFocus = requestedFocus.value;
          for (const anchor of document.querySelectorAll<HTMLAnchorElement>("[data-scoped-graph-route]")) {
            anchor.href = joinBase(import.meta.env.BASE_URL, graphRoute);
          }
          for (const anchor of document.querySelectorAll<HTMLAnchorElement>("a[data-note-route]")) {
            const route = anchor.dataset.noteRoute as LogicalRoute | undefined;
            if (!route) continue;
            anchor.href = joinBase(
              import.meta.env.BASE_URL,
              withGraphFocus(route, knownCompositeIds, requestedFocus.value),
            );
          }
        };
        restoreOriginatingFocus().catch((error) => console.error("[note-navigation] failed to restore graph focus", error));
      }
    </script>
  </body>
</html>
