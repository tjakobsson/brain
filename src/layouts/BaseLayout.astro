---
import "../styles/global.css";
import QuickSwitcher from "../components/QuickSwitcher.astro";
import { joinBase, routes } from "../lib/routes";

interface Props {
  title: string;
  wide?: boolean;
  /** Full-bleed pages (graph): no max-width, no padding. */
  fluid?: boolean;
}

const { title, wide = false, fluid = false } = Astro.props;
const url = (route: import("../lib/routes").LogicalRoute) => joinBase(import.meta.env.BASE_URL, route);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={url(routes.faviconSvg)} />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-header-slot">
      <header class="site-header">
        <nav class="site-nav-pill" aria-label="Primary navigation">
          <a class="nav-action graph-trigger" href={url(routes.home)} aria-label="Graph">
            <svg class="nav-icon graph-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M7.5 7.5 12 5l4.5 2.5v5L12 15l-4.5-2.5z"></path>
              <path d="M7.5 12.5 5 17m11.5-4.5L19 17M12 15v4"></path>
              <circle cx="5" cy="17" r="1.5"></circle>
              <circle cx="19" cy="17" r="1.5"></circle>
              <circle cx="12" cy="20" r="1.5"></circle>
            </svg>
          </a>
          <button
            class="nav-action search-trigger"
            data-open-switcher
            type="button"
            aria-label="Search"
            aria-haspopup="dialog"
            aria-controls="quick-switcher"
          >
            <svg class="nav-icon search-icon" viewBox="0 0 24 24" aria-hidden="true">
              <circle cx="11" cy="11" r="6.5"></circle>
              <path d="m16 16 4 4"></path>
            </svg>
          </button>
          <details class="nav-menu">
            <summary class="nav-action" aria-label="More navigation">
              <svg class="nav-icon expand-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="m14.5 6-6 6 6 6"></path>
              </svg>
            </summary>
            <div class="nav-menu-panel">
              <a href={url(routes.tags)}>Tags</a>
              <a href={url(routes.recent)}>Recent</a>
              <a href={url(routes.orphans)}>Orphans</a>
              <a href={url(routes.search)}>Search</a>
            </div>
          </details>
        </nav>
      </header>
    </div>
    <main class:list={[{ wide, fluid }]}>
      <slot />
    </main>
    <QuickSwitcher />
  </body>
</html>
